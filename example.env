DISCORD_TOKEN=
ENV=dev
# Set ENV=prod to enable daily backups in the same container.

# Network printer:
PRINTER_MODEL=QL-810W
PRINTER_ID=tcp://10.43.249.43:9100
PRINTER_BACKEND=network
# USB printer: change the three settings above, no Compose changes needed.
# PRINTER_MODEL=QL-700
# PRINTER_ID=usb://0x04e9:0x20c0/000D9Z773204
# PRINTER_BACKEND=pyusb
# For the kernel driver use PRINTER_BACKEND=linux_kernel and PRINTER_ID=/dev/usb/lp0.

RESTIC_REPOSITORY=sftp://marcopolo@sol.usbx.me:22//home/marcopolo/backups/labelbot
SFTP_PASSWORD=
# Separate encryption password; keep a recovery copy outside this server.
RESTIC_PASSWORD=
BACKUP_INTERVAL_SECONDS=86400
